#!/usr/bin/env bash
# ==============================================================================
# Executable launcher for NFL DFS Lineup Optimizer
# Usage:
#   ./run_optimizer
#   ./run_optimizer --site fanduel
#   ./run_optimizer --site draftkings
# ==============================================================================

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

# Prioritize repository virtual environment python if present
if [ -f "$DIR/.venv/bin/python" ]; then
    PYTHON_BIN="$DIR/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
else
    PYTHON_BIN="python"
fi

exec "$PYTHON_BIN" "$DIR/run_optimizer.py" "$@"
